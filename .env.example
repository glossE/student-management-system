# Copy this file to backend/.env for local development (never commit the real .env).

# PostgreSQL connection string.
# Local example below; on Render use the database's INTERNAL connection URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_management?schema=public"

# Cloudinary credentials in a single URL (Dashboard → API Environment variable).
# When unset, the API still runs but photo upload is disabled.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Port the Express server listens on. Render injects this automatically.
PORT=3000

# Secret used to sign JWT login tokens. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# The first PRINCIPAL account, seeded on startup if it doesn't exist yet.
PRINCIPAL_EMAIL="principal@pillai.edu"
PRINCIPAL_PASSWORD="change-me"

# Set to "production" on Render so auth cookies are marked Secure (HTTPS-only).
NODE_ENV="development"

# Google OAuth Client ID for "Sign in with Google" (from Google Cloud Console).
# Public value; leave unset to disable Google sign-in. Only pre-added staff emails may sign in.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
