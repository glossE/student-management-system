# Copy this file to backend/.env for local development (never commit the real .env).

# PostgreSQL connection string.
# Local example below; on Render use the database's INTERNAL connection URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_management?schema=public"

# Cloudinary credentials in a single URL (Dashboard → API Environment variable).
# When unset, the API still runs but photo upload is disabled.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Port the Express server listens on. Render injects this automatically.
PORT=3000
